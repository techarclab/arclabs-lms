{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "regions": [
    "sin1"
  ],
  "installCommand": "npm install -g pnpm@12.6.0 && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm exec turbo run build --filter=@arc/api && cd apps/api && pnpm exec prisma migrate deploy",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "crons": [
    {
      "path": "/api/v1/code-runner/ping",
      "schedule": "30 2 * * *"
    }
  ]
}
