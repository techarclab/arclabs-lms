# ---- API ----
NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:3000

# ---- Database (Docker: pnpm infra:up) ----
DATABASE_URL=postgresql://arc:arc_dev_password@localhost:5432/arc_lms?schema=public

# ---- Redis (optional) ----
# Used for the email queue + worker locally. Leave unset on Vercel.
REDIS_URL=redis://localhost:6379

# ---- Email ----
# EMAIL_DELIVERY: queue (Redis + worker) | direct (SMTP from the API, use on Vercel) | log (print only).
# If unset: queue when REDIS_URL is set, else direct when SMTP_HOST is set, else log.
# EMAIL_DELIVERY=direct
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=ARC LABS <no-reply@yourdomain.com>

# ---- Firebase Authentication ----
# Local: use the emulator (pnpm emulators) with the demo project id below — no real Firebase needed.
FIREBASE_PROJECT_ID=demo-arc-labs
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Staging/production: remove the emulator line and provide a service account (JSON as one line):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Object storage (optional for now; SeaweedFS locally, Cloudflare R2 in production) ----
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=arc-lms
S3_ACCESS_KEY_ID=arc_s3_key
S3_SECRET_ACCESS_KEY=arc_s3_secret
S3_FORCE_PATH_STYLE=true

# ---- Bootstrap ----
# This email becomes Super Admin on first sign-in.
SUPER_ADMIN_EMAIL=admin@arclabs.local

# ---- Tests (pnpm test) — separate database, created automatically ----
TEST_DATABASE_URL=postgresql://arc:arc_dev_password@localhost:5432/arc_lms_test?schema=public
