NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1

# Local: Firebase Auth emulator with the demo project (no real Firebase project needed)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-arc-labs
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-arc-labs.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099

# Real Firebase project: copy values from Firebase console > Project settings > Your apps (lms-web),
# and remove NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST.
