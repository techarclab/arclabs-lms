{
  "name": "arc-labs-lms",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "emulators": "firebase emulators:start --only auth --project demo-arc-labs --import=infra/firebase/emulator-data --export-on-exit",
    "db:migrate": "pnpm --filter @arc/api db:migrate",
    "db:seed": "pnpm --filter @arc/api db:seed",
    "db:studio": "pnpm --filter @arc/api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  }
}
